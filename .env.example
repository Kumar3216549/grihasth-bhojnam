# ───────── Grihasth Bhojnam by Sachin — environment variables ─────────
# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection (local, Neon, Supabase, Railway…)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grihasth_bhojnam?schema=public"

# Public URL of the website (used in invoices, WhatsApp links, sitemap, SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth — generate a secret with:  openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Admin login for /admin (Sachin)
ADMIN_USERNAME="sachin"
ADMIN_PASSWORD="choose-a-strong-password"
ADMIN_EMAIL="sachin.j@electrobotic.in"

# Razorpay — https://dashboard.razorpay.com → Account & Settings → API Keys
# Use rzp_test_… keys first, switch to rzp_live_… after KYC.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Razorpay → Webhooks → https://YOUR-DOMAIN/api/razorpay/webhook  (events: payment.captured, order.paid, payment.failed)
RAZORPAY_WEBHOOK_SECRET=""

# Test the online-payment flow WITHOUT Razorpay keys (simulated payment). Only works when keys are empty.
# Must be "false" in production.
PAYMENT_DEMO_MODE="false"

# WhatsApp Business Cloud API (Meta) — optional, for automatic order messages
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Approved template with 4 body variables: name, time, company, order no.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="hi"
